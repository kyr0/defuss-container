# Every environment variable the code reads. Copy to .env only for values you need to change; nothing here is secret.
# The Makefile exports .env to every recipe and to `make start`.

# Daemon, CLI and desktop state directory. Unset: the OS data directory + defuss-container. var/home is what
# `make start` uses, so the CLI and desktop then talk to the development daemon. Never set it to an empty value.
DEFUSS_CONTAINER_HOME=var/home
# Daemon loopback API port; default 63705. 0 picks a free port. Clients read the actual one from connection.json.
DEFUSS_CONTAINER_PORT=63705
# Engine executable the daemon runs; unset: engine/smolvm (smolvm.exe on Windows) in the state directory. Set it only
# to a real path: an empty value makes the daemon refuse to start (VERIFIED: clap rejects it).
# DEFUSS_CONTAINER_ENGINE=/absolute/path/to/smolvm
# `make site`: local port of the project site (docs/); default 63706.
SITE_PORT=63706
# Daemon log filter (tracing EnvFilter syntax); default info.
RUST_LOG=info

# macOS only, when the Command Line Tools' linker is older than their newest SDK (`unknown architecture
# arm64e.x1-macos`): an older installed SDK, e.g. /Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk.
# Empty means the default SDK.
SDKROOT=

# OS-provided base directories scripts/install.py falls back to; empty means the OS default.
XDG_DATA_HOME=
LOCALAPPDATA=

# Tests: Bun used by tests/build.test.mjs (default `bun`).
BUN_EXECUTABLE=bun
# UI interaction tests: a Chromium binary instead of Playwright's (optional), and a screenshot path (optional).
CHROME_EXECUTABLE=
UI_SCREENSHOT=
# GUI e2e engine when desktop/tests/e2e.test.mjs runs alone; tests/e2e/run.py sets it per browser.
E2E_BROWSER=chromium

# examples/hello, read inside the guest. The app spec's `env` sets them; the supervisor sets DEFUSS_APP and NODE_ENV.
PORT=3000
HOST_TEST_PORT=8123
DEFUSS_APP=hello
NODE_ENV=production
